<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{page.title}} · {{site.title}}</title>
  <link rel="stylesheet" href="{{assets.highlight}}">
</head>
<body>
  <main>{{page.html | safe}}</main>
  {% if assets.components %}<script type="module" src="{{assets.components}}"></script>{% endif %}
</body>
</html>
