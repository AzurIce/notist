{% if node.url %}
<a href="{{url(path=node.url, relative_to=current)}}"{% if node.output == current %} aria-current="page"{% endif %}><span class="nav-title">{{node.title}}</span></a>
{% else %}
<span class="nav-{{node.kind}}"{% if node.kind == "draft" %} role="link" aria-disabled="true"{% endif %}><span class="nav-title">{{node.title}}</span></span>
{% endif %}
