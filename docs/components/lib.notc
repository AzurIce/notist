fn panel(title: String = "Panel", expanded: Bool = true)[children: BlockContent] -> BlockContent;
fn badge(label: String, count: Int = 1) -> InlineContent;
fn diagram(source: String, theme: String = "auto") -> BlockContent;

fn notc(source: String) -> BlockContent {
    #node[
        #raw(source, intline: true)
    ]
}
