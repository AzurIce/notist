= Grammar Diagrams

这些图由 docs/packages/grammar 中的 Rust 解析器生成，通过 WASM 交给 grammar::diagram Web Component 展示。
规则引用可以点击跳转；有序选择的分支按编号尝试。虚线框注明捕获、零宽操作、贪婪匹配与提交语义。

== Markup calls

#grammar::diagram(r#"""
syntax CodeCall(ctx) ->
  `#` name:Path args:Args(ctx) body:CallBody(ctx)?
  | `#` name:Path body:CallBody(ctx)
  | `#` body:CallBody(ctx);

syntax Path -> segment:IDENT (COLON_COLON segment:IDENT)*;

syntax Args(ctx) ->
  LPAREN Trivia* (Argument (Trivia* COMMA Trivia* Argument)* Trivia* COMMA?)?
  Trivia* RPAREN;

syntax Argument -> key:ArgKey COLON Trivia* value:Value | value:Value;
"""#, theme: "rust")

== Code declarations

#grammar::diagram(r#"""
syntax FunctionDecl ->
  FN ^ Trivia* name:IDENT Trivia* parameters:ParameterList Trivia*
  mount:ChildrenDecl? Trivia* ARROW Trivia* result:TypeRef Trivia* SEMICOLON;

syntax ParameterList ->
  LPAREN Trivia*
  (parameter:Parameter (Trivia* COMMA Trivia* parameter:Parameter)*
   Trivia* COMMA?)?
  Trivia* RPAREN;

syntax Parameter ->
  name:IDENT Trivia*
  (QUESTION Trivia* COLON Trivia* ty:TypeRef
   | COLON Trivia* ty:TypeRef (Trivia* default:DefaultValue)?);

syntax ChildrenDecl ->
  LBRACKET Trivia* `children` Trivia* COLON Trivia* ty:TypeRef Trivia* RBRACKET;
"""#)

== Context and scanners

#grammar::diagram(r#"""
syntax Item(m, i, ctx) ->
  @{ column(cursor) == i }
  marker:TokenKind(m) WS
  let c = { column(cursor) }
  extent:probe ItemExtent(c; ctx)
  body:within(extent.end,
    ItemBody(ctx with block_indent=c, body_start=cursor));

syntax Table(ctx) ->
  @{ table_start(cursor, ctx) }
  header:scan TableLine(ctx)
  NL delimiter:scan TableLine(ctx)
  (!@{ block_end(cursor, ctx) } NL rows:scan TableLine(ctx))*;
"""#)

== Lexical rules

#grammar::diagram(r#"""
lex Whitespace -> [` ` U+0009]+;
lex Newline -> (U+000D U+000A) | U+000A | U+000D;
lex Digit -> [`0`-`9`];
lex Number -> Digit+ (`.` Digit+)?;
"""#)

== Select one rule

#grammar::diagram(r#"""
lex Digit -> [`0`-`9`];
lex Number -> Digit+ (`.` Digit+)?;
"""#, rule: "Number", theme: "dark")

== Match and construct

#grammar::diagram(r#"""
syntax Heading(ctx) ->
  marker:EQ WS body:InlineRun(ctx, always_true, None)
  => heading(level: size(marker))[lower(body)];

ast MD_Heading -> MD.Heading(level, body)
  => heading(level: level)[lower(body)];
"""#, theme: "rust")
