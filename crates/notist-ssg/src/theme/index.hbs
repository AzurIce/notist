<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{page.title}} · {{site.title}}</title>
<script>try{document.documentElement.dataset.theme=localStorage.getItem('notist-theme')||'auto'}catch(e){}</script>
{{#each assets.styles}}<link rel="stylesheet" href="{{this}}">{{/each}}
<script src="{{assets.script}}" defer></script></head>
<body><a class="skip-link" href="#page-content">Skip to content</a>
<header><button id="nav-toggle" aria-label="Toggle navigation" aria-controls="site-nav" aria-expanded="false">☰</button><a href="{{site.home}}">{{site.title}}</a><button id="theme-toggle" aria-label="Toggle color theme">◐</button></header>
<div class="site-layout"><nav id="site-nav" aria-label="Site navigation"><ul>{{> navigation navigation}}</ul></nav>
<main id="page-content"><nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{{#each breadcrumbs}}<li>{{#if current}}<span aria-current="page">{{title}}</span>{{else}}{{#if url}}<a href="{{url}}">{{title}}</a>{{else}}<span>{{title}}</span>{{/if}}{{/if}}</li>{{/each}}</ol></nav>
<article>{{{page.html}}}</article>
<nav class="adjacent" aria-label="Page navigation">{{#if previous}}<a rel="prev" href="{{previous.url}}">← {{previous.title}}</a>{{else}}<span></span>{{/if}}{{#if next}}<a rel="next" href="{{next.url}}">{{next.title}} →</a>{{/if}}</nav>
</main><aside aria-label="On this page"><h2>On this page</h2><ol>{{#each outline}}<li data-level="{{level}}"><a href="#{{anchor}}">{{title}}</a></li>{{/each}}</ol></aside></div>
{{#if assets.components}}<script type="module" src="{{assets.components}}"></script>{{/if}}
</body></html>
