#grammar.diagram(r#"lex Digit -> [`0`-`9`];"#)
] |
| [mermaid](https://github.com/AzurIce/notist/blob/main/modules/mermaid/README.not) | #node[ Mermaid 图形组件

#mermaid.diagram(r#"""
stateDiagram-v2
    direction LR
    [*] --> s1
    s1 --> [*]
"""#)
] |
| [pele](https://github.com/AzurIce/notist/blob/main/modules/pele/README.not) | #node[ Mermaid 语法、CSS 主题与自适应 SVG

#pele.diagram("flowchart LR; Source[源码] --> IR([Expr 森林]); IR --> Item([Item 树])")
] |
| [katex](https://github.com/AzurIce/notist/blob/main/modules/katex/README.not) | #node[ LaTeX 数学呈现

#katex.math<BlockContent>(r#"""
f(\relax{x}) = \int_{-\infty}^\infty
\hat{f}(\xi)\,e^{2 \pi i \xi x}
\,d\xi
"""#)
]|
| [typst](https://github.com/AzurIce/notist/blob/main/modules/typst/README.not) | #node[ Typst 数学与通用源码经 WASM 编译为 SVG，支持运行时导入 Typst 包

$ e^(i pi) = -1 $
] |
| [shader](https://github.com/AzurIce/notist/blob/main/modules/shader/README.not) | #node[ WebGPU / WGSL 全屏 shader、动画与交互

#shader.canvas(r#"""
fn palette(t: f32) -> vec3f {
  return 0.5 + 0.5 * cos(6.283185 * (vec3f(t) + vec3f(0.0, 0.33, 0.67)));
}

fn mainImage(fragCoord: vec2f) -> vec4f {
  let uv = (2.0 * fragCoord - uniforms.iResolution.xy) / uniforms.iResolution.y;
  let time = uniforms.iTime;
  let wave = sin(uv.x * 4.0 + time) * cos(uv.y * 4.0 - time * 0.7);
  let rings = sin(length(uv) * 10.0 - time * 2.0 + wave);
  let color = palette(rings * 0.18 + length(uv) * 0.15 + time * 0.05);
  return vec4f(color, 1.0);
}
"""#)
] |
