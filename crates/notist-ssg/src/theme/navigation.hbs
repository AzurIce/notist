<li class="nav-item">
  {{#if children}}
  <details class="nav-branch"{{#if expanded}} open{{/if}}>
    <summary class="nav-label">{{#if url}}<a href="{{url}}"{{#if current}} aria-current="page"{{/if}}>{{title}}</a>{{else}}<span class="nav-group">{{title}}</span>{{/if}}</summary>
    <ul class="nav-children">{{#each children}}{{> navigation this}}{{/each}}</ul>
  </details>
  {{else}}
  {{#if url}}<a href="{{url}}"{{#if current}} aria-current="page"{{/if}}>{{title}}</a>{{else}}<span class="nav-group">{{title}}</span>{{/if}}
  {{/if}}
</li>
