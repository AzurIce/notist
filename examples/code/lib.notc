import "./labels.notc" as labels;

fn decorate<C: Type>[children: C] -> C {
    match C {
        InlineContent => strong()[#children],
        BlockContent => [ #children ],
        _ => compile_error("decorate requires content"),
    }
}

fn panel<C: Type>[children: C] -> BlockContent {
    let blocks = if C == InlineContent { [ #children ] } else { children };
    callout(kind: "note")[ #blocks ]
}
