{% if node.url %}
<a href="{{url(path=node.url)}}"{% if node.output == page.route.output %} aria-current="page"{% endif %}><span class="nav-title">{{node.title}}</span></a>
{% else %}
<span class="nav-{{node.kind}}"{% if node.kind == "draft" %} role="link" aria-disabled="true"{% endif %}><span class="nav-title">{{node.title}}</span></span>
{% endif %}
