<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{page.title}} · {{book.title}}</title>
  <link rel="home" href="{{book.home}}">
  <script>
    document.documentElement.classList.add('js');
    try {
      const root = document.documentElement;
      const theme = localStorage.getItem('notist-theme');
      root.dataset.theme = theme === 'light' || theme === 'dark' ? theme : 'auto';
      const home = document.querySelector('link[rel="home"]').href;
      const width = Number(localStorage.getItem(`notist-book-width:${home}`));
      if (Number.isFinite(width) && width > 0) root.style.setProperty('--navigation-user-width', `${width}px`);
    } catch (_) {}
  </script>
  {% for style in assets.styles %}<link rel="stylesheet" href="{{style}}">{% endfor %}
  {% for script in assets.scripts %}<script src="{{script}}" defer></script>{% endfor %}
</head>
<body>
  <a class="skip-link" href="#page-content">Skip to content</a>
  <div id="reading-progress" class="reading-progress" aria-hidden="true"><span></span></div>
  <header class="book-header">
    <div class="header-inner">
      <a class="book-brand" href="{{book.home}}">{{book.title}}</a>
      <button id="nav-toggle" class="text-button" type="button" aria-label="Open contents" aria-controls="book-nav" aria-expanded="false">Contents</button>
      <button id="theme-toggle" class="text-button" type="button" aria-label="Toggle color theme" title="Toggle color theme"><span class="theme-label">Theme</span></button>
    </div>
  </header>
  <div id="nav-backdrop" class="nav-backdrop" hidden aria-hidden="true"></div>
  <div class="book-layout">
    <nav id="book-nav" class="book-navigation" aria-label="Contents">
      <div class="rail-heading"><p class="rail-label">Contents</p><button id="nav-close" class="text-button" type="button" aria-label="Close contents">Close</button></div>
      <ul class="navigation-tree">{% include 'navigation' %}{% for node in navigation %}{{<book_navigation node={node}/>}}{% endfor %}</ul>
    </nav>
    <script>{{assets.navigation | safe}}</script>
    <div id="nav-resize" class="navigation-resize" role="separator" tabindex="0" aria-label="Resize contents" aria-orientation="vertical" aria-controls="book-nav" title="Drag or use arrow keys to resize contents; double-click or press Home to reset"></div>
    <main id="page-content" tabindex="-1">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><ol>{% for crumb in breadcrumbs %}<li>{% if crumb.current %}<span aria-current="page">{{crumb.title}}</span>{% elif crumb.url %}<a href="{{crumb.url}}">{{crumb.title}}</a>{% else %}<span>{{crumb.title}}</span>{% endif %}</li>{% endfor %}</ol></nav>
      {% if outline %}
      <details class="mobile-outline">
        <summary>On this page <span class="outline-state" aria-hidden="true"><span class="outline-show">Show</span><span class="outline-hide">Hide</span></span></summary>
        <ol class="outline-list">{% for heading in outline %}<li data-level="{{heading.level}}"><a data-outline-link href="#{{heading.anchor}}">{{heading.title}}</a></li>{% endfor %}</ol>
      </details>
      {% endif %}
      <article class="prose">{{page.html | safe}}</article>
      {% if previous %}
      <nav class="adjacent" aria-label="Page navigation">
        <a rel="prev" href="{{previous.url}}" class="adjacent-link previous"><span class="adjacent-label">Previous</span><span class="adjacent-title">{{previous.title}}</span></a>
        {% if next %}<a rel="next" href="{{next.url}}" class="adjacent-link next"><span class="adjacent-label">Next</span><span class="adjacent-title">{{next.title}}</span></a>{% endif %}
      </nav>
      {% elif next %}
      <nav class="adjacent" aria-label="Page navigation"><a rel="next" href="{{next.url}}" class="adjacent-link next"><span class="adjacent-label">Next</span><span class="adjacent-title">{{next.title}}</span></a></nav>
      {% endif %}
    </main>
    {% if outline %}
    <aside class="page-outline" aria-label="On this page">
      <nav id="page-outline" aria-label="Page outline"><p class="rail-label">On this page</p><ol class="outline-list">{% for heading in outline %}<li data-level="{{heading.level}}"><a data-outline-link href="#{{heading.anchor}}">{{heading.title}}</a></li>{% endfor %}</ol></nav>
    </aside>
    {% endif %}
    <footer class="book-footer"><span>{{book.title}}</span><a href="#page-content">Back to top</a></footer>
  </div>
  {% if assets.components %}<script type="module" src="{{assets.components}}"></script>{% endif %}
</body>
</html>
